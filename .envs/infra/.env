# =============================================================================
# INFRASTRUCTURE CONFIG
# =============================================================================

# -----------------------------------------------------------------------------
# DOCKER REGISTRY
# -----------------------------------------------------------------------------
COMPANY_DOCKER_REGISTRY_HOST=docker-registry.company

# -----------------------------------------------------------------------------
# PROJECT
# -----------------------------------------------------------------------------
COMPANY_HIRING_PROJECT_NAME=hiring
COMPANY_HIRING_VERSION=1.0.0

# -----------------------------------------------------------------------------
# APP SERVICES - AUTH
# -----------------------------------------------------------------------------
COMPANY_HIRING_AUTH_APP_NAME=auth
COMPANY_HIRING_AUTH_HOST=auth.hiring.company
COMPANY_HIRING_AUTH_HTTP_PORT=8080
COMPANY_HIRING_AUTH_GRPC_PORT=50051
COMPANY_HIRING_AUTH_JWT_SECRET=jwt-secret

# -----------------------------------------------------------------------------
# APP SERVICES - BLOG
# -----------------------------------------------------------------------------
COMPANY_HIRING_BLOG_APP_NAME=blog
COMPANY_HIRING_BLOG_HOST=blog.hiring.company
COMPANY_HIRING_BLOG_HTTP_PORT=8081

# -----------------------------------------------------------------------------
# APP SERVICES - NOTIFICATIONS
# -----------------------------------------------------------------------------
COMPANY_HIRING_NOTIFICATIONS_APP_NAME=notifications
COMPANY_HIRING_NOTIFICATIONS_HOST=notifications.hiring.company
COMPANY_HIRING_NOTIFICATIONS_PORT=8082

# -----------------------------------------------------------------------------
# POSTGRESQL - COMMON
# -----------------------------------------------------------------------------
COMPANY_HIRING_POSTGRES_DATABASE=hiring
COMPANY_HIRING_POSTGRES_SUPERUSER_USERNAME=company_pg_super_user
COMPANY_HIRING_POSTGRES_SUPERUSER_PASSWORD=company_pg_super_password
COMPANY_HIRING_POSTGRES_REPLICATOR_USERNAME=company_pg_replicator_user
COMPANY_HIRING_POSTGRES_REPLICATOR_PASSWORD=company_pg_replicator_password
COMPANY_HIRING_POSTGRES_PRIMARY_USERNAME=company_pg_write_user
COMPANY_HIRING_POSTGRES_PRIMARY_PASSWORD=company_pg_write_password
COMPANY_HIRING_POSTGRES_REPLICA_USERNAME=company_pg_read_user
COMPANY_HIRING_POSTGRES_REPLICA_PASSWORD=company_pg_read_password

# -----------------------------------------------------------------------------
# POSTGRESQL - PRIMARY
# -----------------------------------------------------------------------------
COMPANY_HIRING_POSTGRES_PRIMARY_HOST=primary.postgres.hiring.company
COMPANY_HIRING_POSTGRES_PRIMARY_PORT=5432

# -----------------------------------------------------------------------------
# POSTGRESQL - REPLICA
# -----------------------------------------------------------------------------
COMPANY_HIRING_POSTGRES_REPLICA_HOST=replica.postgres.hiring.company
COMPANY_HIRING_POSTGRES_REPLICA_PORT=5432

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
COMPANY_HIRING_REDIS_HOST=redis.hiring.company
COMPANY_HIRING_REDIS_PORT=6379
COMPANY_HIRING_REDIS_USERNAME=company_redis_username
COMPANY_HIRING_REDIS_PASSWORD=company_redis_password

# -----------------------------------------------------------------------------
# KAFKA
# -----------------------------------------------------------------------------
COMPANY_HIRING_KAFKA_HOST=kafka.hiring.company
COMPANY_HIRING_KAFKA_PORT=9092
COMPANY_HIRING_KAFKA_USERNAME=company_kafka_username
COMPANY_HIRING_KAFKA_PASSWORD=company_kafka_password

# -----------------------------------------------------------------------------
# NETWORK
# -----------------------------------------------------------------------------
PG_NETWORK=hiring_backend